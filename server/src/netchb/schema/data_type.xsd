<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
     targetNamespace="http://www.netchb.com/xml/data"
     xmlns:data="http://www.netchb.com/xml/data"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema"
     elementFormDefault="qualified"
     attributeFormDefault="unqualified">
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="billNoType">
		<xsd:annotation>
			<xsd:documentation>
				This should be used to constrain bill of lading numbers
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="[\dA-Za-z]{0,50}"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="carrierCodeType">
		<xsd:annotation>
			<xsd:documentation>
				Carrier code must be 2 or 4 characters
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\w{2}|\w{4}|\*{1}[\*\w]{1}" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="classCodeType">
		<xsd:annotation>
			<xsd:documentation>
				Class Code types include cotton fee, MPF, HMF
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="053" />
			<xsd:enumeration value="054" />
			<xsd:enumeration value="055" />
			<xsd:enumeration value="056" />
			<xsd:enumeration value="057" />
			<xsd:enumeration value="079" />
			<xsd:enumeration value="090" />
			<xsd:enumeration value="102" />
			<xsd:enumeration value="103" />
			<xsd:enumeration value="104" />
			<xsd:enumeration value="105" />
			<xsd:enumeration value="106" />
			<xsd:enumeration value="107" />
			<xsd:enumeration value="108" />
			<xsd:enumeration value="109"/>
			<xsd:enumeration value="110"/>
