			<xsd:enumeration value="501" />
			<xsd:enumeration value="311" />
			<xsd:enumeration value="496" />
			<xsd:enumeration value="500" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="countryCodeType">
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="[A-Za-z]{2}" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="dollarAmountType">
		<xsd:annotation>
			<xsd:documentation>
				Base type for dollar values
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:decimal">
			<xsd:minInclusive value="0" />
			<xsd:fractionDigits value="2" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="entryNoType">
		<xsd:annotation>
			<xsd:documentation>
				An entryNo must be 7 digits, except in rare cases where an 
				8th digit is required as the leading check digit, as noted 
				in the module-specific schema.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\d{7,8}" />
		</xsd:restriction>
	</xsd:simpleType>
	
