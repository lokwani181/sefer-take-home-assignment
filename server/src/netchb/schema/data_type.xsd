			<xsd:documentation>
				This is contains all of the valid paymentType codes
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="" />
			<xsd:enumeration value="1" />
			<xsd:enumeration value="2" />
			<xsd:enumeration value="3" />
			<xsd:enumeration value="5" />
			<xsd:enumeration value="6" />
			<xsd:enumeration value="7" />
			<xsd:enumeration value="8" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- **************************************************************** -->
	<xsd:simpleType name="portType">
		<xsd:annotation>
			<xsd:documentation>
				This is the data type that should be used for ports.  It requires
				a String that is 4 numeric digits
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\d{4}" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="specialProgramType">
		<xsd:annotation>
			<xsd:documentation>
				This should be used for primary or country special programs
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:maxLength value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="secondarySpecialProgramType">
		<xsd:annotation>
			<xsd:documentation>
				This should be used for secondary special programs
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:maxLength value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="suretyCodeType">
		<xsd:annotation>
			<xsd:documentation>
				Only ensures that value is at most 3 characters long
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:maxLength value="3" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- **************************************************************** -->
	<xsd:simpleType name="taxIdType">
		<xsd:annotation>
			<xsd:documentation>
				This checks for valid taxIds
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\d{2}-\d{7}[\dA-Za-z]?[\dA-Za-z]?|\d{6}-\d{5}|\d{3}-\d{2}-\d{4}" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="tariffNoType">
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\d{5,10}"/>
		</xsd:restriction>
	</xsd:simpleType>
	
