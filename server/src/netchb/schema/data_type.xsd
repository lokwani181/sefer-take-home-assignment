	<!-- ************************************************* -->
	<xsd:simpleType name="filerCodeType">
		<xsd:annotation>
			<xsd:documentation>
				This is the data type that is used to validate filer codes
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="[A-Za-z0-9]{3}" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- ************************************************* -->
	<xsd:simpleType name="foreignPortType">
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\d{5}"/>
		</xsd:restriction>
	</xsd:simpleType>

	<!-- **************************************************************** -->
	<xsd:simpleType name="inbondNoType">
		<xsd:annotation>
			<xsd:documentation>
				This validates that the inbond no matches certain patterns
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\d{9}|[\dA-Za-z]{10}|\d{11}|[Vv][\dA-Za-z]{2}\d{8}"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="invoiceNoType">
		<xsd:annotation>
			<xsd:documentation>
				This should be used to validate invoice numbers for invoices
				that are part of an entry summary
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="[A-Za-z\d\-]{1,17}"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- **************************************************************** -->
	<xsd:simpleType name="manufacturerIdType">
		<xsd:annotation>
			<xsd:documentation>MIDs and supplier ids</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:maxLength value="15"/>
		</xsd:restriction>
	</xsd:simpleType>
	
